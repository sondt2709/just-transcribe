<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the teal gradient from flutter/icon.svg
     (#009688 top-left → #00695C bottom-right). Corner rounding comes from the
     launcher mask, not this drawable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#009688"
        android:endColor="#00695C"
        android:type="linear" />
</shape>
