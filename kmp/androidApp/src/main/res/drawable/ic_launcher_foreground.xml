<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the white microphone artwork from flutter/icon.svg,
     scaled (0.66 about the center) so it stays inside the 66dp safe zone under any
     launcher mask. Also used as the monochrome themed-icon layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.66"
        android:scaleY="0.66">
        <!-- Microphone body (capsule) -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"
            android:pathData="M41,27 a9,9 0 0 1 18,0 v10 a9,9 0 0 1 -18,0 z" />
        <!-- Stand arc -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeAlpha="0.95"
            android:strokeLineCap="round"
            android:pathData="M28,44 Q28,60 50,60 Q72,60 72,44" />
        <!-- Pole and base -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeAlpha="0.95"
            android:strokeLineCap="round"
            android:pathData="M50,60 L50,68 M40,68 L60,68" />
        <!-- Text lines -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeAlpha="0.7"
            android:strokeLineCap="round"
            android:pathData="M21.75,77.75 L53.25,77.75" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeAlpha="0.5"
            android:strokeLineCap="round"
            android:pathData="M21.75,84.75 L43.25,84.75" />
        <!-- Soundwave bars -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeAlpha="0.9"
            android:strokeLineCap="round"
            android:pathData="M63.5,75.5 L63.5,84.5" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeAlpha="0.7"
            android:strokeLineCap="round"
            android:pathData="M69.5,78.5 L69.5,82.5" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeAlpha="0.5"
            android:strokeLineCap="round"
            android:pathData="M75.5,76.5 L75.5,83.5" />
    </group>
</vector>
